  "request": {
    "title": "Request",
    "subtitle": "Tell us which device or feature you want next. We read every request.",
    "submitLabel": "Send request",
    "successText": "Opening your request...",
    "errorText": "Please fill the required fields.",
    "submit": {
      "type": "github-issue",
      "url": "https://github.com/pox-project/requests/issues/new",
      "to": "requests@pox-project.org",
      "titlePrefix": "[Request]"
    },
    "fields": [
      {
        "id": "name",
        "label": "Your name",
        "type": "text",
        "required": true
      },
      {
        "id": "contact",
        "label": "Contact (email or telegram)",
        "type": "text",
        "required": true
      },
      {
        "id": "project",
        "label": "Project",
        "type": "select",
        "optionsFrom": "projects",
        "extraOptions": [
          "Something else"
        ],
        "required": true,
        "inTitle": true
      },
      {
        "id": "device",
        "label": "Device name & codename",
        "type": "text",
        "required": true,
        "inTitle": true
      },
      {
        "id": "message",
        "label": "Details",
        "type": "textarea",
        "required": false
      }
    ]
  },
  "picker": {
    "minProjects": 5
  }
